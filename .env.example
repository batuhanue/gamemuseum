# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# development | preview | production | test
APP_ENV=development
# 32+ random chars. Signs OAuth state cookies and share tokens.
SESSION_SECRET=

# ── Database (Vercel Postgres / Neon via Vercel Marketplace) ───────
# Leave empty locally to use the embedded PGlite database in ./.data/pglite
DATABASE_URL=
# Optional: where PGlite stores data when DATABASE_URL is empty
PGLITE_DIR=.data/pglite

# ── File storage (Vercel Blob) for 3D models ───────────────────────
# Leave empty locally: uploads go to ./public/uploads (development only)
BLOB_READ_WRITE_TOKEN=

# ── Google sign-in (optional) ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Transactional e-mail (verification / password reset, optional) ─
# Without it, links are printed to the server log in development only.
RESEND_API_KEY=
EMAIL_FROM="Game Museum <no-reply@example.com>"

# ── IGDB (Twitch application credentials) ──────────────────────────
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Optional bootstrap token. Never treated as permanent: the server
# fetches/refreshes app tokens with the client credentials and tracks expiry.
IGDB_ACCESS_TOKEN=

# ── Steam (optional, for library import) ───────────────────────────
STEAM_WEB_API_KEY=

# ── Admin bootstrap ────────────────────────────────────────────────
# Comma separated e-mails that are promoted to admin when they register.
ADMIN_EMAILS=
